---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} — Chill e Guy`} description={post.data.description}>
  <Header />
  <main id="main-content">
    <article class="article section">
      <p class="kicker">{post.data.category} · {post.data.readTime}</p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-body"><Content /></div>
    </article>
  </main>
  <Footer />
</Layout>
