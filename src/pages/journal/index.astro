---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import JournalCard from '../../components/JournalCard.astro';
import { getCollection } from 'astro:content';
import '../../styles/journal.css';
const posts = (await getCollection('journal')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = ['All', 'Technology', 'Entertainment', 'Digital Culture'];
---
<Layout title="Journal — Chill e Guy" description="Ideas on technology, entertainment, and digital culture." bodyClass="journal-page">
  <Header theme="editorial" />
  <main id="main-content">
    <section class="journal-heading" id="journal-top" aria-labelledby="journal-title">
      <div><p class="journal-kicker">Journal</p><h1 id="journal-title">Ideas worth<br />thinking about.</h1><p class="journal-topics">Technology · Entertainment · Digital Culture</p></div>
      <div class="journal-filters" role="group" aria-label="Filter articles by category" hidden>
        {categories.map(category => <button type="button" data-category={category} aria-pressed={category === 'All' ? 'true' : 'false'}>{category}</button>)}
      </div>
    </section>
    <section class="journal-list" aria-label="Journal articles">
      <div class="journal-editorial-grid">
        {posts.map(post => <div class="journal-entry" data-post-category={post.data.category}><JournalCard title={post.data.title} description={post.data.description} category={post.data.category} readTime={post.data.readTime} href={`/journal/${post.id}/`} /></div>)}
      </div>
      <p class="journal-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </section>
    <section class="journal-closing" aria-labelledby="journal-closing-title">
      <img src="/images/studio-architecture.png" alt="A person walking through light and shadow beside a concrete wall" width="1536" height="1024" loading="lazy" />
      <div><h2 id="journal-closing-title">Good ideas<br />keep moving.</h2><p>More stories coming soon.</p><a class="text-link" href="#journal-top">Back to top <span aria-hidden="true">↑</span></a></div>
    </section>
  </main>
  <Footer />
</Layout>
<script>
  const filters = document.querySelector<HTMLElement>('.journal-filters');
  const buttons = filters?.querySelectorAll<HTMLButtonElement>('button');
  const entries = document.querySelectorAll<HTMLElement>('.journal-entry');
  const status = document.querySelector<HTMLElement>('.journal-status');
  if (filters && buttons) {
    filters.hidden = false;
    buttons.forEach(button => button.addEventListener('click', () => {
      const category = button.dataset.category;
      let count = 0;
      entries.forEach(entry => {
        entry.hidden = category !== 'All' && entry.dataset.postCategory !== category;
        if (!entry.hidden) count++;
      });
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      if (status) status.textContent = `${count} ${count === 1 ? 'article' : 'articles'}${category === 'All' ? '' : ` in ${category}`}.`;
    }));
  }
</script>
