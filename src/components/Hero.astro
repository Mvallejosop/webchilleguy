---
import SectionLabel from './SectionLabel.astro';
import AccentStroke from './AccentStroke.astro';
---
<section class="home-hero mockup-section">
 <div class="hero-copy"><SectionLabel number="01" label="Creative Consulting & Brand Storytelling" /><h1>Ideas<br />need<br />stories.</h1><p class="territory">Technology · Entertainment · Digital Culture</p><div class="hero-actions"><a class="button button-accent" href="/services/">Explore what we do <span aria-hidden="true">→</span></a><a class="text-link" href="/journal/">Read the Journal</a></div></div>
 <div class="hero-portrait"><img src="/images/hero-editorial.png" alt="A person in a black cap looking across the Manhattan skyline" width="1024" height="1280" fetchpriority="high" decoding="async" /><AccentStroke /></div>
 <aside class="hero-aside" aria-label="Our perspective"><div class="city-detail"><img src="/images/culture.jpg" alt="City buildings and traffic at dusk" width="900" height="1126" /><span aria-hidden="true"></span></div><div class="aside-words">Ideas<br />People<br />Culture<span class="aside-line"></span><svg viewBox="0 0 40 40" width="36" height="36" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="20" cy="20" r="17"/><ellipse cx="20" cy="20" rx="8" ry="17"/><ellipse cx="20" cy="20" rx="17" ry="7"/><path d="M3 20h34M20 3v34"/></svg></div></aside>
</section>
